{
  "name": "glia",
  "version": "0.0.1",
  "private": true,
  "description": "Glia — capture, preserve, and read coding-agent Sessions",
  "homepage": "https://glia.fyi",
  "bugs": {
    "url": "https://github.com/anxndsgn/glia/issues"
  },
  "license": "Apache-2.0",
  "author": "XIN",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anxndsgn/glia.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "bun run --cwd packages/cli typecheck",
    "test": "bun test",
    "build": "bun run --cwd packages/cli build",
    "install:local": "bun run --cwd packages/cli install:local",
    "dev:cli": "bun run --cwd packages/cli dev"
  },
  "devDependencies": {
    "oxfmt": "^0.58.0"
  },
  "packageManager": "bun@1.3.14"
}
